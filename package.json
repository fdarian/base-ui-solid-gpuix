{
	"name": "base-ui-solid-gpuix",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Headless Base UI primitives for Solid on @gpuix/solid, ported from @base-ui/react 1.9.0.",
	"license": "MIT",
	"packageManager": "pnpm@12.11.2",
	"exports": {
		"./*": "./src/*/index.ts"
	},
	"scripts": {
		"check": "pnpm check:type && pnpm check:test",
		"check:type": "tsc",
		"check:test": "bun test",
		"format": "biome check --write"
	},
	"peerDependencies": {
		"@gpuix/solid": "*",
		"solid-js": "1.9.15"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@gpuix/native": "link:../gpuix/packages/native",
		"@gpuix/solid": "file:../gpuix/packages/solid",
		"@total-typescript/tsconfig": "latest",
		"@types/bun": "^1.4.2",
		"solid-js": "1.9.15",
		"typescript": "^7.0.2"
	}
}
